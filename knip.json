{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts"],
      "project": ["scripts/**/*.ts"]
    },
    "apps/companion": {
      "entry": ["src/main.ts", "test/providers/record-*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "apps/mcp": {
      "entry": ["src/server.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/contracts": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    }
  },
  "ignoreBinaries": ["luacheck", "claude", "codex", "cursor-agent"],
  "ignoreDependencies": []
}
