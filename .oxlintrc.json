{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "import"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/ban-ts-comment": "error"
  },
  "env": {
    "node": true,
    "es2023": true
  },
  "ignorePatterns": ["**/dist/**", "addon/**", "docs/specs/**"]
}
